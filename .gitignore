# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg

# Environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Data: nothing under the top-level data/ is tracked. MIMIC-IV, EHRSHOT and any
# MEDS extract derived from them are credentialed and must never be committed.
# Leading slash so this does not also swallow src/ehrjepa/data/.
/data/
*.parquet
*.csv
*.csv.gz

# ...except the tiny synthetic fixtures the ETL tests run against. These are
# hand-written, contain no real patient data, and must be tracked.
!tests/fixtures/**

# ...and except the metric logs of the recorded experiments, which are derived
# aggregates over a public synthetic dataset and are the point of docs/.
!docs/experiments/**

# Runs, checkpoints, logs
checkpoints/
runs/
logs/
outputs/
results/
*.pth
*.pth.tar
*.ckpt
*.log
*.tmp
